# Per-shot kerneled IQ datasets (large, re-downloadable from IBM job ids in *.submit)
*.npz

# Orphaned copy of the repo pulled off the training pod (22 MB of session2 checkpoints)
bench/results/h200_session2/pathfinder/

# Model checkpoints ARE tracked in-repo — they back the paper's reproducibility claims
# (paper §5.11 points reproducers at the in-repo finetune/calibrated ckpts, verified by SHA-256).
# Only genuinely exploratory, unreferenced checkpoints are kept local (their train logs are
# still published; the weights back no reported number):
bench/results/h200_main/calibrated_phigh040/**/*.pt
bench/results/h200_main/ibm_budget/**/*.pt
bench/results/h200_main/soft/**/*.pt

# coda_experiments/ is local exploratory scratch. Publish ONLY the files the paper cites
# (the IBM-Heron real-hardware decode pipeline); everything else stays local.
coda_experiments/*
!coda_experiments/decode_ibm_result.py
!coda_experiments/redecode_ibm_d3r3_pfwl3s.py
!coda_experiments/redecode_ibm_d5r5_pfwl3s.py
!coda_experiments/eval_ibm_d7r7.py
!coda_experiments/ibm_full_eval.json
!coda_experiments/README.md

# Per-script generated result dirs (regenerated by running the scripts)
qldpc/results/
qldpc/__pycache__/

# coda_experiments logs kept local (the allowlist above already excludes its checkpoints)
coda_experiments/**/*.log

# Internal working notes / advisory-review correspondence (not part of the public record)
CODA_*.md
*_HANDOFF.md
*_STATUS.md
*_RUNNING.md
OVERNIGHT_SUMMARY_*.md
FRONTIER_SCOPE_*.md
QLDPC_PIVOT_SCOPE.md
QLDPC_EQUIVARIANCE_VERIFIED.md
BEYOND_PM_ROUTES_GATED_*.md
CEILING_RESULT_*.md
SOFT_READOUT_VERDICT.txt
MLD_RESULT.txt
paper/FRAMING_DECISION_*.md
paper/PAPER_SPEC_*.md
qldpc/TRACK2_*.md

# Session log scratch + the 108 MB pod mirror (checkpoints + run logs, regenerable)
bench/results/h200_main/pod_mirror/
**/*_DONE.txt
**/SOFT_PROGRESS.txt

# Work-in-progress paper section drafts (folded into paper/pathfinder.md when finalized)
paper/SECTION_*_DRAFT.md
paper/SECTION_5_15_1_real_hardware_FINAL.md

# Raw training console logs (verbose; train_log.json carries the structured metrics)
bench/results/h200_main/**/*.log

# Stale compiled HTML (regenerate from paper/pathfinder.md; embeds absolute figure paths)
paper/pathfinder.html
